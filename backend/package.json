{
  "name": "pharmadash-backend",
  "version": "1.0.0",
  "description": "PharmaDash Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "seed": "node scripts/seed.js",
    "seed:ts": "ts-node scripts/seed.ts",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:silent": "jest --silent"
  },
  "dependencies": {
    "@prisma/client": "5.8.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "helmet": "7.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.5",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.11",
    "@types/node": "18.19.3",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "9.0.7",
    "jest": "^29.7.0",
    "nodemon": "3.0.2",
    "prisma": "5.8.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  }
}

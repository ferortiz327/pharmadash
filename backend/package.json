{
  "name": "pharmadash-backend",
  "version": "1.0.0",
  "description": "PharmaDash Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "seed": "node scripts/seed.js",
